<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="local_voice_lexicon.json" />
        <exclude domain="file" path="local_voice_lexicon.json.corrupt.bak" />
        <exclude domain="file" path="local_voice_lexicon.json.tmp" />
        <exclude
            domain="file"
            path="usr" />
        <exclude
            domain="file"
            path="descriptor.json" />
        <exclude
            domain="file"
            path="licenses.json" />
        <exclude
            domain="file"
            path="README.md" />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="file"
            path="usr" />
        <exclude
            domain="file"
            path="descriptor.json" />
        <exclude
            domain="file"
            path="licenses.json" />
        <exclude
            domain="file"
            path="README.md" />
    </device-transfer>
</data-extraction-rules>
